{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.token)"
    ],
    "ask": [
      "Edit(**/internal/guardrail/**)",
      "Write(**/internal/guardrail/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)",
      "Read(**/data/**)",
      "Read(**/logs/**)",
      "Read(**/archive/**)",
      "Read(**/dl/**)",
      "Read(**/downloads/**)",
      "Read(**/*.duckdb)",
      "Read(**/*.duckdb.wal)",
      "Read(**/*.jsonl)",
      "Read(**/*.jsonl.gz)",
      "Read(**/*.parquet)",
      "Read(**/*.log)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
